---
import Layout from "@/src/core/Layout.astro";
import { DropzoneComponent } from "../_components/Dropzone";
import CitiesSelect from "@/src/landingPage/componentes/ContactForm/CitiesSelect";
---

<Layout>
  <main class="container mx-auto px-4 py-8 max-w-2xl">
    <div class="rounded-lg p-6">
      <h2 class="text-xl font-medium text-gray-800 mb-6">
        Crear Nuevo Cliente
      </h2>
      <form
        action="/api/v1/clients/create"
        method="post"
        enctype="multipart/form-data"
        class="space-y-4"
      >
        <!-- Información Personal -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="name" class="text-sm text-gray-600"> Nombre </label>
            <input
              type="text"
              name="name"
              id="name"
              required
              class="mt-1 w-full px-3 py-2 bg-white border border-gray-200 rounded-md focus:outline-none focus:border-gray-400 transition"
            />
          </div>
          <div>
            <label for="lastname" class="text-sm text-gray-600">
              Apellido
            </label>
            <input
              type="text"
              name="lastname"
              id="lastname"
              required
              class="mt-1 w-full px-3 py-2 bg-white border border-gray-200 rounded-md focus:outline-none focus:border-gray-400 transition"
            />
          </div>
        </div>

        <div>
          <label for="email" class="text-sm text-gray-600">
            Correo Electrónico
          </label>
          <input
            type="email"
            name="email"
            id="email"
            required
            class="mt-1 w-full px-3 py-2 bg-white border border-gray-200 rounded-md focus:outline-none focus:border-gray-400 transition"
          />
        </div>

        <!-- Información de Detalles -->
        <CitiesSelect isDark={false} client:load />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="plan" class="text-sm text-gray-600">Plan</label>
            <select
              name="plan"
              class="mt-1 w-full px-3 py-2 bg-white border border-gray-200 rounded-md focus:outline-none focus:border-gray-400 transition"
            >
              <option>Básico</option>
              <option>Premium</option>
              <option>Pro</option>
            </select>
          </div>
          <div>
            <label for="mode" class="text-sm text-gray-600">Modalidad</label>
            <select
              name="mode"
              class="mt-1 w-full px-3 py-2 bg-white border border-gray-200 rounded-md focus:outline-none focus:border-gray-400 transition"
            >
              <option>Presencial</option>
              <option>Virtual</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="contact_type" class="text-sm text-gray-600">
              Tipo de Contacto
            </label>
            <select
              name="contact_type"
              class="mt-1 w-full px-3 py-2 bg-white border border-gray-200 rounded-md focus:outline-none focus:border-gray-400 transition"
            >
              <option>Correo Electrónico</option>
              <option>Teléfono</option>
              <option>WhatsApp</option>
            </select>
          </div>
          <div>
            <label for="contact_info" class="text-sm text-gray-600">
              Información de Contacto
            </label>
            <input
              type="text"
              name="contact_info"
              id="contact_info"
              class="mt-1 w-full px-3 py-2 bg-white border border-gray-200 rounded-md focus:outline-none focus:border-gray-400 transition"
            />
          </div>
        </div>

        <!-- Subir Archivos -->
        <div class="mt-6">
          <h3 class="text-sm font-medium text-gray-600 mb-2">Subir Archivos</h3>
          <DropzoneComponent client:load />
        </div>

        <!-- Acciones -->
        <div class="flex gap-3 pt-6">
          <button
            type="submit"
            class="px-4 py-2 bg-gray-800 text-white text-sm rounded-md hover:bg-gray-700 transition"
          >
            Crear Cliente
          </button>
          <a
            href="/admin/clients"
            class="px-4 py-2 border border-gray-200 text-sm text-gray-600 rounded-md hover:bg-gray-50 transition"
          >
            Volver
          </a>
        </div>
      </form>
    </div>
  </main>
</Layout>
