---
interface Props {
  /**
   * Si es true, el header se mostrará en modo oscuro.
   * Por defecto: false.
   */
  isDarkMode?: boolean;
}
const { user } = Astro.locals;

const { isDarkMode = false } = Astro.props;
---

<header
  class={`w-full py-4 px-6 transition-colors duration-300 ${
    !isDarkMode
      ? "bg-gray-900 text-white"
      : "bg-transparent text-white absolute"
  }`}
>
  <div class="container mx-auto flex justify-between items-center">
    <!-- LOGOTIPO -->
    <a href="/" aria-label="Ir a la página de inicio" class="flex-shrink-0">
      <img
        class="h-12 w-auto md:h-16"
        src={"/h-dealer-logo-white.svg"}
        alt="Logotipo de H Dealer"
      />
    </a>

    <!-- BOTÓN HAMBURGER (visible solo en móviles) -->
    <label
      for="drawer-toggle"
      class="md:hidden p-2 rounded-lg transition-colors hover:bg-gray-800 cursor-pointer"
      aria-label="Abrir menú de navegación"
    >
      <i class="fa fa-bars"></i>
    </label>

    <!-- NAVEGACIÓN (oculta en móvil, visible en desktop) -->
    <nav aria-label="Menú principal" class="hidden md:block">
      <ul class="flex gap-8 items-center text-sm">
        <li>
          <a
            href="/"
            class="py-2 border-b-2 border-transparent hover:border-primary transition-colors"
            >Inicio</a
          >
        </li>
        <li>
          <a
            href="/es/sobre-nosotros"
            class="py-2 border-b-2 border-transparent hover:border-primary transition-colors"
            >Sobre Nosotros</a
          >
        </li>
        <li>
          <a
            href="/es/servicios"
            class="py-2 border-b-2 border-transparent hover:border-primary transition-colors"
            >Servicios</a
          >
        </li>
        <li>
          <a
            href="/blog"
            class="py-2 border-b-2 border-transparent hover:border-primary transition-colors"
            >Blog</a
          >
        </li>
        {
          user ? (
            <li>
              <a
                href="/admin"
                class="py-2 border-b-2 border-transparent hover:border-primary transition-colors"
              >
                Admin
              </a>
            </li>
          ) : null
        }
      </ul>
    </nav>
  </div>
</header>

<!-- Input que controla el drawer -->
<input type="checkbox" id="drawer-toggle" class="peer hidden" />

<!-- Drawer lateral -->
<div
  class="fixed inset-y-0 left-0 w-64 bg-gray-900 text-white shadow-lg transform -translate-x-full peer-checked:translate-x-0 transition-transform duration-300 z-40"
>
  <div class="p-4 border-b font-bold text-lg">Menú</div>
  <ul class="p-4 space-y-2">
    <li>
      <a href="/" class="block hover:text-primary transition-colors">Inicio</a>
    </li>
    <li>
      <a
        href="/es/sobre-nosotros"
        class="block hover:text-primary transition-colors">Sobre Nosotros</a
      >
    </li>
    <li>
      <a href="/es/servicios" class="block hover:text-primary transition-colors"
        >Servicios</a
      >
    </li>
    <li>
      <a href="/blog" class="block hover:text-primary transition-colors">Blog</a
      >
    </li>
    {
      user ? (
        <li>
          <a href="/admin" class="block hover:text-primary transition-colors">
            Admin
          </a>
        </li>
      ) : null
    }
  </ul>
</div>

<!-- Fondo oscuro cuando el drawer está abierto -->
<label
  for="drawer-toggle"
  class="peer-checked:block hidden fixed inset-0 bg-black bg-opacity-40 z-30 cursor-pointer"
></label>
